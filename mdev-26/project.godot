; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MDEV26"
run/main_scene="uid://qnc0yqsiqpv6"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://Assets/2D/icon.svg"

[autoload]

PerspectiveManager="*res://Scripts/perspective_manager.gd"
Inventory="*res://Scripts/inventory.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://Assets/": "red",
"res://Extras/": "orange",
"res://Scenes/": "green",
"res://Scripts/": "yellow"
}

[global_group]

2.5DPlayer=""
Grabble=""

[gui]

common/auto_focus_strategy=1

